  <joint
    name="l_rm75_camera_rojoint"
    type="fixed">
    <!--
      The physical bracket is rigid.  Flip the complete camera assembly by pi
      about link_7 X (the vertical axis through the bracket pivot in the zero
      pose), moving the bracket from the body side to the hand side without
      moving the pivot itself.
    -->
    <origin
      xyz="-0.033 0.0085 -0.05388"
      rpy="-1.5707963268 -1.5707963268 0" />
    <parent
      link="l_rm75_link_7" />
    <child
      link="l_rm75_camera_rolink" />
  </joint>
